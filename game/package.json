{
  "name": "minor-sabotage",
  "private": true,
  "version": "0.1.0",
  "description": "Minor Sabotage (Mały Sabotaż): a squad game of the Polish underground, 1943. The TypeScript game; the C++ prototype at the repository root is frozen.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shot": "node tools/shot.mjs",
    "flow": "node tools/shot.mjs --steps tools/flow.json"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
